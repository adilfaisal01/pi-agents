{
  "cycleKey": "alt+a",
  "default": "oracle",
  "order": [
    "oracle",
    "plan",
    "build",
    "yolo",
    "forge"
  ],
  "modes": {
    "oracle": {
      "label": "oracle",
      "badge": "🔍 oracle",
      "color": "accent",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "bash"
      ],
      "dropTools": [
        "edit",
        "write",
        "multiedit",
        "apply_patch"
      ],
      "writeScope": [],
      "bash": "safe",
      "keepExtensions": true,
      "promptFile": "prompts/oracle.md"
    },
    "plan": {
      "label": "plan",
      "badge": "📋 plan",
      "color": "warning",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "bash"
      ],
      "writeScope": [
        "docs",
        "ledger.md"
      ],
      "bash": "safe",
      "keepExtensions": true,
      "promptFile": "prompts/plan.md"
    },
    "build": {
      "label": "build",
      "badge": "🔨 build",
      "color": "success",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "edit",
        "write",
        "bash"
      ],
      "writeDeny": [
        "tests",
        "conftest.py",
        "pyproject.toml",
        "pytest.ini",
        "tox.ini",
        "setup.cfg"
      ],
      "bash": "all",
      "keepExtensions": true,
      "promptFile": "prompts/build.md"
    },
    "yolo": {
      "label": "yolo",
      "badge": "⚡ yolo",
      "color": "error",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "edit",
        "write",
        "bash"
      ],
      "bash": "all",
      "keepExtensions": true,
      "promptFile": "prompts/yolo.md"
    },
    "forge": {
      "label": "forge",
      "badge": "⚒️ forge",
      "color": "success",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "edit",
        "write",
        "subagent",
        "bash"
      ],
      "writeDeny": [
        ".claude",
        ".codex",
        ".agents",
        ".pi",
        ".github",
        ".beads",
        ".harness",
        "harness",
        "gate"
      ],
      "writeDenyReason": "this mode may not edit the forge machinery (.claude, .codex, .agents, .pi, .github, .beads, .harness, harness, gate) — those trees are the floors that watch the agent. Say what the change is and why, and leave it to the human.",
      "bash": "all",
      "keepExtensions": true,
      "promptFile": "prompts/forge.md"
    }
  }
}
